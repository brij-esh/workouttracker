POSTGRES_USER=workout_user
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Host-mapped Kafka port (EXTERNAL listener). In-compose services use kafka:29092.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=true

REDIS_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
KAFKA_UI_PORT=8089
GATEWAY_PORT=8080

# Shared secret between API Gateway and downstream services.
GATEWAY_INTERNAL_TOKEN=local-dev-gateway-token

# Docker Compose service DNS names (override for local IDE runs).
USER_SERVICE_URL=http://user-service:8081
WORKOUT_SERVICE_URL=http://workout-service:8082
PROGRESS_SERVICE_URL=http://progress-service:8083
NUTRITION_SERVICE_URL=http://nutrition-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085
