    {
      "name": "1. Users",
      "description": "User profile APIs via gateway \u2192 user-service.\n\nEnums:\n- `gender`: MALE | FEMALE | OTHER | PREFER_NOT_TO_SAY\n- `fitnessGoal`: LOSE_WEIGHT | BUILD_MUSCLE | STAY_FIT | ENDURANCE | GENERAL_HEALTH\n- `activityLevel`: SEDENTARY | LIGHT | MODERATE | ACTIVE | VERY_ACTIVE\n- `preferredUnits`: METRIC | IMPERIAL",
      "item": [
        {
          "name": "Create Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('userProfileId', body.id);",
                  "    pm.collectionVariables.set('firebaseUid', body.firebaseUid);",
                  "    pm.test('Profile created', () => pm.expect(body.displayName).to.be.ok);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Brijesh Yadav\",\n  \"heightCm\": 175.5,\n  \"weightKg\": 72.0,\n  \"dateOfBirth\": \"1995-05-20\",\n  \"gender\": \"MALE\",\n  \"fitnessGoal\": \"BUILD_MUSCLE\",\n  \"activityLevel\": \"MODERATE\",\n  \"preferredUnits\": \"METRIC\",\n  \"onboardingCompleted\": true\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/{{apiVersion}}/users",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "users"
              ]
            },
